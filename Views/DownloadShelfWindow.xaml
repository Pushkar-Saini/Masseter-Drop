<Window x:Class="MasseterDrop.Views.DownloadShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MasseterDrop.Converters"
        xmlns:helpers="clr-namespace:MasseterDrop.Helpers"
        mc:Ignorable="d"
        Title="Masseter Drop Shelf"
        Width="500" Height="222"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <converters:RelativeTimeConverter x:Key="RelativeTimeConverter" />
        <converters:FileSizeConverter x:Key="FileSizeConverter" />
        <converters:CategoryColorConverter x:Key="CategoryColorConverter" />
        <converters:CategoryIconGeometryConverter x:Key="CategoryIconGeometryConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:BooleanToVisibilityConverter x:Key="InvertedBoolToVisConverter" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter" />
        <converters:NullToVisibilityConverter x:Key="InvertedNullToVisConverter" Invert="True" />

        <!-- Frosted Glass Context Menu -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#E6161B24" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F5F6F8" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="#E6161B24" BorderThickness="1" CornerRadius="12" Padding="5">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#40FFFFFF" Offset="0" />
                                    <GradientStop Color="#15FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.6" Color="#000000" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#F5F6F8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="7" Margin="2,1" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="#18FFFFFF" Margin="4,3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Invisible ScrollBar Style for clean dock cards -->
        <Style x:Key="HiddenScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
        </Style>

        <Style x:Key="CleanDockScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Wrapper with RenderTransform for smooth animations -->
    <Grid Margin="12">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ShelfScaleTransform" CenterX="250" CenterY="111" ScaleX="1.0" ScaleY="1.0" />
                <TranslateTransform x:Name="ShelfTranslateTransform" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- MAIN GLASSPANE SURFACE: Frosted Glassmorphism with Live Wallpaper Light Reflection -->
        <Border x:Name="ShelfSurface"
                CornerRadius="18"
                BorderThickness="1"
                ClipToBounds="True">
            <!-- Specular Edge Gradient (Catches top-left light like real cut glass) -->
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#55FFFFFF" Offset="0.0" />
                    <GradientStop Color="#1EFFFFFF" Offset="0.35" />
                    <GradientStop Color="#0AFFFFFF" Offset="0.75" />
                    <GradientStop Color="#2870A5FF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.BorderBrush>

            <!-- Translucent Dark Frosted Glass Tint -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                    <GradientStop Color="#F0181C26" Offset="0.0" />
                    <GradientStop Color="#E611141D" Offset="0.5" />
                    <GradientStop Color="#DC0D1016" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <!-- Soft, diffuse multi-layered drop shadow -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="#000000" />
            </Border.Effect>

            <Grid>
                <!-- LAYER 1: Ambient Wallpaper Light Gradients (Aurora/Glow Spheres like ChatGPT Desktop) -->
                <Grid IsHitTestVisible="False">
                    <!-- Dynamic Cursor-Following Ambient Light / Spotlight (ChatGPT Desktop Glassmorphism) -->
                    <Ellipse x:Name="AmbientSpotlight"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Width="320" Height="240"
                             Margin="-160,-120,0,0"
                             IsHitTestVisible="False">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="SpotlightTransform" X="80" Y="40" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#2E4E8DFF" Offset="0.0" />
                                <GradientStop Color="#144E8DFF" Offset="0.45" />
                                <GradientStop Color="#004E8DFF" Offset="1.0" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Bottom-Right Soft Violet/Indigo Warmth Glow -->
                    <Ellipse HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="260" Height="180" Margin="0,0,-50,-60">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#188A60FF" Offset="0.0" />
                                <GradientStop Color="#008A60FF" Offset="1.0" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Top Specular Sheen Line -->
                    <Border VerticalAlignment="Top" Height="1" Margin="20,0,20,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                <GradientStop Color="#35FFFFFF" Offset="0.3" />
                                <GradientStop Color="#35FFFFFF" Offset="0.7" />
                                <GradientStop Color="#00FFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- LAYER 2: Shelf Structure -->
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="38" />
                        <!-- Cards Stack -->
                        <RowDefinition Height="*" />
                        <!-- Dismissal Progress Line -->
                        <RowDefinition Height="2.5" />
                    </Grid.RowDefinitions>

                    <!-- FROSTED GLASS HEADER -->
                    <Border Grid.Row="0"
                            Background="#12FFFFFF"
                            BorderBrush="#10FFFFFF"
                            BorderThickness="0,0,0,1"
                            Padding="14,0"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: App Brand -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Glowing Translucent Chevron Badge -->
                                <Border Width="22" Height="22" CornerRadius="7" Background="#22FFFFFF" BorderBrush="#3570A5FF" BorderThickness="1" Margin="0,0,8,0">
                                    <Path Data="M7 10l5 5 5-5z M11 4h2v8h-2z M5 17h14v2H5z" Fill="#70A5FF" Stretch="Uniform" Width="11" Height="11" />
                                </Border>

                                <TextBlock Text="Masseter Drop" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Right: Glass Action Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Open Downloads Folder -->
                                <Button Click="OpenFolderButton_Click" ToolTip="Open Downloads Folder" Width="26" Height="26" Margin="0,0,4,0"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                                                <Path Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"
                                                      Fill="#A6B1C2" Stretch="Uniform" Width="12" Height="12" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#22FFFFFF" />
                                                    <Setter TargetName="b" Property="BorderBrush" Value="#18FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Settings Button -->
                                <Button Click="SettingsButton_Click" ToolTip="Preferences" Width="26" Height="26" Margin="0,0,4,0"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                                                <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                                      Fill="#A6B1C2" Stretch="Uniform" Width="12" Height="12" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#22FFFFFF" />
                                                    <Setter TargetName="b" Property="BorderBrush" Value="#18FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Close / Dismiss Button -->
                                <Button Click="CloseButton_Click" ToolTip="Dismiss shelf (Esc)" Width="26" Height="26"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                                                <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                      Fill="#A6B1C2" Stretch="Uniform" Width="10" Height="10" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#28FFFFFF" />
                                                    <Setter TargetName="b" Property="BorderBrush" Value="#20FFFFFF" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- MAIN SHELF AREA: PREVIEWS STACK -->
                    <Grid Grid.Row="1" Margin="12,10">
                        <!-- Empty State Placeholder -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding FilteredDownloads.IsEmpty, Converter={StaticResource BoolToVisConverter}}">
                            <Border Width="40" Height="40" CornerRadius="10" Background="#18FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"
                                      Fill="#657288" Stretch="Uniform" Width="18" Height="18" />
                            </Border>
                            <TextBlock Text="No recent downloads" FontSize="13" FontWeight="Medium" Foreground="#CBD3DF" HorizontalAlignment="Center" />
                            <TextBlock Text="Completed browser downloads automatically pop up here" FontSize="11" Foreground="#78869E"
                                       HorizontalAlignment="Center" Margin="0,3,0,0" />
                        </StackPanel>

                        <!-- Horizontal Dock Preview Cards -->
                        <ScrollViewer x:Name="ShelfScrollViewer"
                                      Style="{StaticResource CleanDockScrollViewer}"
                                      PreviewMouseWheel="ShelfScrollViewer_PreviewMouseWheel">
                            <ItemsControl ItemsSource="{Binding FilteredDownloads}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- FROSTED GLASS CARD -->
                                        <Border x:Name="CardBorder"
                                                Width="104" Height="140"
                                                Background="#18FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Margin="0,0,8,0"
                                                Padding="5"
                                                Cursor="Hand"
                                                helpers:DragDropHelper.IsDraggable="True"
                                                ToolTip="{Binding FullPath}"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                            <!-- Specular Glass Border for Each Card -->
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#30FFFFFF" Offset="0.0" />
                                                    <GradientStop Color="#10FFFFFF" Offset="0.6" />
                                                    <GradientStop Color="#1A70A5FF" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>

                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="CardLiftTransform" Y="0" />
                                            </Border.RenderTransform>

                                            <!-- Context Menu -->
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Open" Command="{Binding PlacementTarget.Tag.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <Path Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                                                                  Fill="#70A5FF" Stretch="Uniform" Width="12" Height="12" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Show in File Explorer" Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <Path Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"
                                                                  Fill="#A6B1C2" Stretch="Uniform" Width="12" Height="12" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Copy File Path" Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                                                  Fill="#A6B1C2" Stretch="Uniform" Width="12" Height="12" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Copy File" Command="{Binding PlacementTarget.Tag.CopyFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                        <MenuItem.Icon>
                                                            <Path Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
                                                                  Fill="#A6B1C2" Stretch="Uniform" Width="12" Height="12" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Dismiss Shelf" Click="DismissMenuItem_Click">
                                                        <MenuItem.Icon>
                                                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                                  Fill="#A6B1C2" Stretch="Uniform" Width="11" Height="11" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>

                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <!-- Visual Thumbnail Box -->
                                                    <RowDefinition Height="78" />
                                                    <!-- File Name -->
                                                    <RowDefinition Height="Auto" />
                                                    <!-- File Metadata -->
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- 1. RECESSED GLASS THUMBNAIL WELL -->
                                                <Border Grid.Row="0"
                                                        Background="#20000000"
                                                        CornerRadius="8"
                                                        BorderBrush="#10FFFFFF"
                                                        BorderThickness="1"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <!-- Image/Document Preview (Displayed ONLY when real preview is available) -->
                                                        <Image Source="{Binding Thumbnail}"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Margin="3"
                                                               Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisConverter}}" />

                                                        <!-- Fallback File Icon (Displayed ONLY when file preview is NOT available) -->
                                                        <Path Data="{Binding Category, Converter={StaticResource CategoryIconGeometryConverter}}"
                                                              Fill="{Binding Category, Converter={StaticResource CategoryColorConverter}}"
                                                              Stretch="Uniform" Width="30" Height="30"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Visibility="{Binding HasPreview, Converter={StaticResource InvertedBoolToVisConverter}}" />

                                                        <!-- NEW Badge Indicator for Fresh Arrivals -->
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Margin="0,4,4,0"
                                                                Background="#805C9EFF"
                                                                BorderBrush="#40FFFFFF"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="4,1"
                                                                Visibility="{Binding IsJustDownloaded, Converter={StaticResource BoolToVisConverter}}">
                                                            <TextBlock Text="NEW" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </Border>

                                                        <!-- Downloading In-Progress Spinner -->
                                                        <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Bottom"
                                                                     Background="Transparent" Foreground="#70A5FF" BorderThickness="0"
                                                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisConverter}}" />
                                                    </Grid>
                                                </Border>

                                                <!-- 2. FILE NAME -->
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding FileName}"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           Foreground="#F5F7FA"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           MaxWidth="94"
                                                           Margin="0,5,0,1" />

                                                <!-- 3. FILE METADATA -->
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding FormattedSize}"
                                                           FontSize="10"
                                                           Foreground="#94A0B2"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Card Interactive Triggers -->
                                        <DataTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="#2EFFFFFF" />
                                                <Setter TargetName="CardBorder" Property="BorderBrush">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#60FFFFFF" Offset="0" />
                                                            <GradientStop Color="#4070A5FF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- GLOWING LASER DISMISSAL TIMER PROGRESS BAR -->
                    <Border Grid.Row="2" Background="#10FFFFFF" HorizontalAlignment="Stretch">
                        <ProgressBar x:Name="DismissalProgressBar"
                                     Height="2.5"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="100"
                                     Background="Transparent"
                                     Foreground="#70A5FF"
                                     BorderThickness="0"
                                     HorizontalAlignment="Stretch" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
