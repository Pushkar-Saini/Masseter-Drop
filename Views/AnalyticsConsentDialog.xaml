<Window x:Class="MasseterDrop.Views.AnalyticsConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Help improve Masseter Drop"
        Height="360" Width="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="12" CaptionHeight="44" />
    </WindowChrome.WindowChrome>

    <Border Background="#17191E" CornerRadius="12" BorderBrush="#323642" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#22252C" BorderBrush="#70A5FF" BorderThickness="1" Margin="0,0,12,0">
                        <!-- Shield / Privacy Icon -->
                        <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"
                              Fill="#70A5FF" Stretch="Uniform" Width="16" Height="16" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Help improve Masseter Drop" FontSize="16" FontWeight="SemiBold" Foreground="#F5F6F8" />
                        <TextBlock Text="Anonymous Product Analytics" FontSize="11" Foreground="#A1A6B0" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Click="DeclineButton_Click" Width="30" Height="30"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                      Fill="#A1A6B0" Stretch="Uniform" Width="12" Height="12" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#323642" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Body Content -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Would you like to share anonymous usage statistics to help us understand how Masseter Drop is used and improve future versions? We never collect your file names, file paths or document contents."
                           FontSize="12" Foreground="#C6CAD2" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16" />

                <!-- Privacy Assurances Box -->
                <Border Background="#22252C" CornerRadius="8" Padding="12" BorderBrush="#2B2F38" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Our privacy commitment:" FontSize="11" FontWeight="SemiBold" Foreground="#F5F6F8" Margin="0,0,0,6" />
                        <TextBlock Text="• Zero personal data, usernames, accounts, or IP logging." FontSize="11" Foreground="#A1A6B0" Margin="0,0,0,4" />
                        <TextBlock Text="• File names, paths, download URLs, and contents are NEVER collected." FontSize="11" Foreground="#A1A6B0" Margin="0,0,0,4" />
                        <TextBlock Text="• You can change this preference anytime in Settings." FontSize="11" Foreground="#A1A6B0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Actions Footer -->
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Don't share analytics" Click="DeclineButton_Click"
                        Background="#2B2F38" Foreground="#A1A6B0" BorderThickness="0" Padding="14,9"
                        HorizontalAlignment="Left" Cursor="Hand" FontSize="12">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="1" Content="Allow anonymous analytics" Click="AllowButton_Click"
                        Background="#70A5FF" Foreground="#17191E" FontWeight="SemiBold"
                        BorderThickness="0" Padding="16,9" Cursor="Hand" FontSize="12">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
