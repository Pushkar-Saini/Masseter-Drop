<Window x:Class="MasseterDrop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Masseter Drop Settings"
        Height="540" Width="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="12" CaptionHeight="44" />
    </WindowChrome.WindowChrome>

    <Border Background="#17191E" CornerRadius="12" BorderBrush="#323642" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="7" Background="#22252C" BorderBrush="#70A5FF" BorderThickness="1" Margin="0,0,10,0">
                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                              Fill="#70A5FF" Stretch="Uniform" Width="14" Height="14" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="#F5F6F8" />
                        <TextBlock Text="Configure Masseter Drop preferences" FontSize="12" Foreground="#A1A6B0" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Click="CloseButton_Click" Width="30" Height="30"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                      Fill="#A1A6B0" Stretch="Uniform" Width="12" Height="12" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#323642" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Settings Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Monitored Downloads Folder -->
                    <Border Background="#22252C" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#2B2F38" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Monitored Folder" FontWeight="Medium" Foreground="#F5F6F8" Margin="0,0,0,4" />
                            <TextBlock Text="Directory monitored for new and completed downloads" FontSize="11" Foreground="#A1A6B0" Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtFolderPath" IsReadOnly="True" Background="#17191E" Foreground="#F5F6F8"
                                         BorderBrush="#323642" BorderThickness="1" Padding="8,6" FontSize="12" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Content="Browse..." Click="BrowseFolder_Click" Background="#2B2F38" Foreground="#F5F6F8"
                                            BorderThickness="0" Padding="12,6" Cursor="Hand" Margin="0,0,6,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6" />
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="Reset" Click="ResetFolder_Click" Background="#2B2F38" Foreground="#A1A6B0"
                                            BorderThickness="0" Padding="10,6" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6" />
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Behavior Toggles -->
                    <Border Background="#22252C" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#2B2F38" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Behavior" FontWeight="Medium" Foreground="#F5F6F8" Margin="0,0,0,12" />

                            <CheckBox x:Name="ChkStartup" Content="Launch Masseter Drop at Windows startup" Foreground="#F5F6F8" Margin="0,0,0,12" Cursor="Hand" />
                            <CheckBox x:Name="ChkStartMinimized" Content="Start in background / minimized" Foreground="#F5F6F8" Margin="0,0,0,12" Cursor="Hand" />
                            <CheckBox x:Name="ChkKeepRunning" Content="Keep application running after closing panel" Foreground="#F5F6F8" Margin="0,0,0,12" Cursor="Hand" />
                            <CheckBox x:Name="ChkAutoDismiss" Content="Auto-dismiss panel when clicking outside" Foreground="#F5F6F8" Cursor="Hand" />
                        </StackPanel>
                    </Border>

                    <!-- Preferences (History limit & Theme) -->
                    <Border Background="#22252C" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#2B2F38" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Preferences" FontWeight="Medium" Foreground="#F5F6F8" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Maximum recent files" Foreground="#F5F6F8" />
                                    <TextBlock Text="Limit retained download history" FontSize="11" Foreground="#A1A6B0" />
                                </StackPanel>
                                <ComboBox x:Name="CmbMaxFiles" Grid.Column="1" Width="90" Background="#17191E" Foreground="#F5F6F8"
                                          BorderBrush="#323642" VerticalAlignment="Center">
                                    <ComboBoxItem Content="50" />
                                    <ComboBoxItem Content="100" />
                                    <ComboBoxItem Content="200" />
                                    <ComboBoxItem Content="500" />
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Theme" Foreground="#F5F6F8" />
                                    <TextBlock Text="Select interface visual appearance" FontSize="11" Foreground="#A1A6B0" />
                                </StackPanel>
                                <ComboBox x:Name="CmbTheme" Grid.Column="1" Width="90" Background="#17191E" Foreground="#F5F6F8"
                                          BorderBrush="#323642" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Dark" />
                                    <ComboBoxItem Content="Light" />
                                    <ComboBoxItem Content="System" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Action Buttons -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="Open Downloads Folder" Click="OpenFolder_Click" Background="Transparent" Foreground="#70A5FF"
                        BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="12" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Click="CloseButton_Click" Background="#2B2F38" Foreground="#A1A6B0"
                            BorderThickness="0" Padding="16,8" Margin="0,0,8,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Save Settings" Click="SaveButton_Click" Background="#70A5FF" Foreground="#17191E"
                            FontWeight="SemiBold" BorderThickness="0" Padding="16,8" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
