<Window x:Class="MasseterDrop.Views.DownloadsPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MasseterDrop.Converters"
        xmlns:helpers="clr-namespace:MasseterDrop.Helpers"
        mc:Ignorable="d"
        Title="Masseter Drop"
        Width="380" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <converters:RelativeTimeConverter x:Key="RelativeTimeConverter" />
        <converters:FileSizeConverter x:Key="FileSizeConverter" />
        <converters:CategoryColorConverter x:Key="CategoryColorConverter" />
        <converters:CategoryIconGeometryConverter x:Key="CategoryIconGeometryConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:BooleanToVisibilityConverter x:Key="InvertedBoolToVisConverter" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter" />

        <!-- Modern ScrollViewer ScrollBar Style -->
        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="#4A5060" CornerRadius="3" Opacity="0.5" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ModernScrollBarThumb}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context Menu Style -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#22252C" />
            <Setter Property="BorderBrush" Value="#323642" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F5F6F8" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="#22252C" BorderBrush="#323642" BorderThickness="1" CornerRadius="8" Padding="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="#000000" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#F5F6F8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="5" Margin="2,1" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2B2F38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="#323642" Margin="4,3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Background="#17191E" CornerRadius="12" BorderBrush="#323642" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Search Bar -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Downloads List -->
                <RowDefinition Height="*" />
                <!-- Row 3: Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- A. HEADER -->
            <Border Grid.Row="0" Background="#22252C" CornerRadius="11,11,0,0" Padding="14,12" BorderBrush="#2B2F38" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand Icon & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="6" Background="#17191E" BorderBrush="#70A5FF" BorderThickness="1" Margin="0,0,10,0">
                            <!-- Masseter stylized download chevron -->
                            <Path Data="M7 10l5 5 5-5z M11 4h2v8h-2z M5 17h14v2H5z" Fill="#70A5FF" Stretch="Uniform" Width="14" Height="14" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Downloads" FontSize="15" FontWeight="SemiBold" Foreground="#F5F6F8" Margin="0,0,8,0" />
                                <Border Background="#2B2F38" CornerRadius="9" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FilteredCountDisplay}" FontSize="11" Foreground="#A1A6B0" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Header Actions: Refresh, Settings, Close -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Refresh Button -->
                        <Button Command="{Binding RefreshCommand}" ToolTip="Refresh downloads list" Width="28" Height="28" Margin="0,0,4,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                              Fill="#A1A6B0" Stretch="Uniform" Width="13" Height="13" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#2B2F38" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Settings Button -->
                        <Button Command="{Binding OpenSettingsCommand}" ToolTip="Settings" Width="28" Height="28" Margin="0,0,4,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                              Fill="#A1A6B0" Stretch="Uniform" Width="13" Height="13" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#2B2F38" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Close Button -->
                        <Button Click="CloseButton_Click" ToolTip="Hide panel" Width="28" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                              Fill="#A1A6B0" Stretch="Uniform" Width="11" Height="11" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#323642" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- B. SEARCH BAR -->
            <Border Grid.Row="1" Background="#1B1E24" Padding="12,10" BorderBrush="#2B2F38" BorderThickness="0,0,0,1">
                <Border Background="#22252C" CornerRadius="8" BorderBrush="#2B2F38" BorderThickness="1" Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search Icon -->
                        <Path Grid.Column="0" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                              Fill="#717886" Stretch="Uniform" Width="13" Height="13" Margin="2,0,8,0" VerticalAlignment="Center" />

                        <!-- Search Input -->
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="#F5F6F8"
                                 CaretBrush="#70A5FF" FontSize="12" VerticalAlignment="Center" x:Name="TxtSearch" />

                        <!-- Placeholder Text -->
                        <TextBlock Grid.Column="1" Text="Search downloads..." Foreground="#5B6271" FontSize="12"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"
                                   Visibility="{Binding HasSearchText, Converter={StaticResource InvertedBoolToVisConverter}}" />

                        <!-- Clear Search Button -->
                        <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Width="16" Height="16"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisConverter}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                          Fill="#717886" Stretch="Uniform" Width="9" Height="9" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Border>

            <!-- C. DOWNLOAD LIST -->
            <Grid Grid.Row="2">
                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                            Visibility="{Binding FilteredDownloads.IsEmpty, Converter={StaticResource BoolToVisConverter}}">
                    <Border Width="48" Height="48" CornerRadius="12" Background="#22252C" BorderBrush="#2B2F38" BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"
                              Fill="#4A5060" Stretch="Uniform" Width="22" Height="22" />
                    </Border>
                    <TextBlock Text="No downloads found" FontSize="14" FontWeight="Medium" Foreground="#A1A6B0" HorizontalAlignment="Center" />
                    <TextBlock Text="Downloaded files will automatically appear here" FontSize="11" Foreground="#5B6271"
                               HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <!-- List Box -->
                <ListBox ItemsSource="{Binding FilteredDownloads}"
                         SelectedItem="{Binding SelectedDownload}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         Padding="6,6"
                         MouseDoubleClick="DownloadList_MouseDoubleClick">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="2,2" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="helpers:DragDropHelper.IsDraggable" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="8,7">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="#22252C" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="#2B2F38" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding FullPath}"
                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Grid.ColumnDefinitions>
                                    <!-- Icon badge -->
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Name and Metadata -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Quick Actions / Badges -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Context Menu -->
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open" Command="{Binding PlacementTarget.Tag.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <Path Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                                                      Fill="#70A5FF" Stretch="Uniform" Width="12" Height="12" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Show in File Explorer" Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <Path Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"
                                                      Fill="#A1A6B0" Stretch="Uniform" Width="12" Height="12" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Copy File Path" Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                                      Fill="#A1A6B0" Stretch="Uniform" Width="12" Height="12" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Copy File" Command="{Binding PlacementTarget.Tag.CopyFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <Path Data="M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm2 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
                                                      Fill="#A1A6B0" Stretch="Uniform" Width="12" Height="12" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Remove from Recent List" Command="{Binding PlacementTarget.Tag.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                      Fill="#E56B6F" Stretch="Uniform" Width="12" Height="12" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <!-- File Icon Badge -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#17191E"
                                        BorderBrush="#2B2F38" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Grid>
                                        <!-- Native Preview if available -->
                                        <Image Source="{Binding Thumbnail}" Width="24" Height="24" Stretch="Uniform"
                                               Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisConverter}}" />

                                        <!-- Fallback Vector Icon colored by Category (only when preview is not available) -->
                                        <Path Data="{Binding Category, Converter={StaticResource CategoryIconGeometryConverter}}"
                                              Fill="{Binding Category, Converter={StaticResource CategoryColorConverter}}"
                                              Stretch="Uniform" Width="16" Height="16"
                                              Visibility="{Binding HasPreview, Converter={StaticResource InvertedBoolToVisConverter}}" />
                                    </Grid>
                                </Border>

                                <!-- File Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <!-- File Name -->
                                    <TextBlock Text="{Binding FileName}" FontWeight="Medium" FontSize="13" Foreground="#F5F6F8"
                                               TextTrimming="CharacterEllipsis" MaxWidth="220" />

                                    <!-- Metadata Row: Size • Time -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="#A1A6B0" />
                                        <TextBlock Text=" • " FontSize="11" Foreground="#5B6271" />
                                        <TextBlock Text="{Binding DateAdded, Converter={StaticResource RelativeTimeConverter}}"
                                                   FontSize="11" Foreground="#717886" />
                                    </StackPanel>

                                    <!-- Downloading Progress Indicator (when applicable) -->
                                    <ProgressBar IsIndeterminate="True" Height="2" Margin="0,4,0,0" Background="#2B2F38" Foreground="#70A5FF"
                                                 BorderThickness="0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisConverter}}" />
                                </StackPanel>

                                <!-- Status Badges / Actions -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                    <!-- Missing Badge -->
                                    <Border Background="#3B2326" CornerRadius="4" Padding="5,2" Margin="0,0,4,0"
                                            Visibility="{Binding IsAvailable, Converter={StaticResource InvertedBoolToVisConverter}}">
                                        <TextBlock Text="Missing" FontSize="10" Foreground="#E56B6F" FontWeight="SemiBold" />
                                    </Border>

                                    <!-- Downloading Badge -->
                                    <Border Background="#1C2E4A" CornerRadius="4" Padding="5,2" Margin="0,0,4,0"
                                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="Downloading" FontSize="10" Foreground="#70A5FF" FontWeight="SemiBold" />
                                    </Border>

                                    <!-- Reveal Button -->
                                    <Button Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Show in File Explorer" Width="24" Height="24"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="revBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <Path Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                                                          Fill="#5B6271" Stretch="Uniform" Width="10" Height="10" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="revBorder" Property="Background" Value="#323642" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Toast Notification Overlay -->
                <Border Background="#2B2F38" CornerRadius="8" Padding="12,6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,16" BorderBrush="#323642" BorderThickness="1"
                        Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisConverter}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="#000000" />
                    </Border.Effect>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#F5F6F8" FontWeight="Medium" />
                </Border>
            </Grid>

            <!-- D. FOOTER -->
            <Border Grid.Row="3" Background="#22252C" CornerRadius="0,0,11,11" Padding="14,10" BorderBrush="#2B2F38" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Open Downloads Folder Action -->
                    <Button Command="{Binding OpenDownloadsFolderCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand"
